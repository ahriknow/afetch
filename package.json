{
    "name": "@ahriknow/afetch",
    "version": "0.0.1",
    "description": "A lightweight, type-safe fetch API wrapper for modern JavaScript/TypeScript",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "README_zh-CN.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "lint": "eslint src/ --ext .ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "fetch",
        "http",
        "request",
        "client",
        "api",
        "typescript",
        "async",
        "await",
        "plugin",
        "retry",
        "abort",
        "timeout"
    ],
    "author": "ahriknow <ahriknow@ahriknow.com>",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/ahriknow/afetch.git"
    },
    "bugs": {
        "url": "https://github.com/ahriknow/afetch/issues"
    },
    "homepage": "https://github.com/ahriknow/afetch#readme",
    "sideEffects": false,
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@typescript/native-preview": "beta",
        "eslint": "^8.57.0",
        "jest": "^29.7.0",
        "prettier": "^3.2.0",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}